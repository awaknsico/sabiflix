# =============================================================================
# SabiFlix — environment configuration
# Copy this file to .env.local and fill in the values.
# =============================================================================

# --- Clerk Authentication ---
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret (for /api/clerk/webhook)
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk route overrides (optional)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Cloudflare D1 ---
# Account ID + D1 database id + API token for HTTP access from Node/Vercel.
# Used in NON-dev deployments (or locally when FORCE_D1_HTTP=1). In local dev
# (`next dev`) the app prefers the seeded local libsql file at .data/sabiflix.db
# (create it with: pnpm db:seed:local) so it works without a live Cloudflare DB.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_D1_DATABASE_ID=your-d1-database-id
CF_D1_TOKEN=your-d1-api-token
# FORCE_D1_HTTP=1   # optional: use the remote D1 even in local dev

# --- Upstash Redis (optional, for rate limiting + caching) ---
# Get these from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
